# Supabase Configuration
# For development/demo mode, you can leave these as placeholder values
# The app will automatically run in demo mode if these are not properly configured

VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Furniture API Configuration
# Real furniture catalog API - no API key needed, 500 requests/day
VITE_FURNITURE_API_URL=https://furniture-api.fly.dev

# If you want to disable Supabase and run in demo mode only, you can comment out these lines
# or set them to "demo" values like above
